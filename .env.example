# ============================================================
# Creative Intelligence – Environment-Variablen
#
# Kopieren nach:
#   apps/web/.env.local   (Next.js)
#   apps/worker/.env      (Worker; mit dotenv/tsx --env-file laden)
# Niemals echte Keys committen.
# ============================================================

# ---------- Supabase (Web-App) ----------
# Lokal: Werte aus `supabase start` / `supabase status` (in packages/db).
# Cloud: Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-Role-Key: NUR serverseitig (Worker, Seed, Admin-Aktionen).
# Supabase Dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Supabase (Worker) ----------
# Gleiche Werte wie oben – der Worker läuft ggf. auf anderer Infrastruktur
# (Railway/Fly.io) und bekommt sie dort als Secrets gesetzt.
SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY wird auch vom Worker genutzt (s. o.)

# Poll-Intervall der Job-Queue in Millisekunden (optional, Default 2000)
WORKER_POLL_INTERVAL_MS=2000
# Eindeutiger Name dieser Worker-Instanz (optional, sonst generiert)
WORKER_ID=

# ---------- Anthropic (ab Phase 1) ----------
# https://console.anthropic.com → API Keys
# Haiku: Massen-Klassifikation · Sonnet: Frame-Analyse · Opus: Synthese/Generierung
ANTHROPIC_API_KEY=

# ---------- OpenAI Whisper (ab Phase 3, Transkription) ----------
# https://platform.openai.com → API Keys
OPENAI_API_KEY=

# ---------- Apify (ab Phase 1, TikTok/Instagram-Actors) ----------
# https://console.apify.com → Settings → Integrations → API token
APIFY_TOKEN=

# ---------- Meta Ad Library (ab Phase 1) ----------
# https://developers.facebook.com → App anlegen → Ad Library API Zugang
# (Identitätsprüfung erforderlich: https://www.facebook.com/ID)
META_AD_LIBRARY_ACCESS_TOKEN=

# ---------- App ----------
# Basis-URL der Web-App (E-Mail-Redirects, absolute Links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
